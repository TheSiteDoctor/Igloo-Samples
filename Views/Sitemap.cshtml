<?xml version="1.0" encoding="UTF-8" ?>

@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Linq;
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    Layout = null;
    Context.Response.ContentType = "text/xml";
}

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    @{ListChildNodes(Model.Root());}
</urlset>

@functions{
    string ValueOrDefault(IPublishedContent content, string alias, string defaultValue, Fallback fallback)
    {
        var value = content.Value<string>(alias, fallback: fallback);
        return string.IsNullOrWhiteSpace(value) ? defaultValue : value;
    }

    void ListChildNodes(IPublishedContent root)
    {
        if (root.Root().Id == root.Id)
        {
            <url>
                <loc>@root.Url(mode: UrlMode.Absolute)</loc>
                <lastmod>@(string.Format("{0:s}+00:00", root.UpdateDate))</lastmod>
                <changefreq>@ValueOrDefault(root, "sitemapPageChangeFrequently", "daily", Fallback.ToDefaultValue)</changefreq>
                <priority>@ValueOrDefault(root, "sitemapPagePriority", "0.5", Fallback.ToDefaultValue)</priority>
            </url>
        }

        foreach (var node in root.Children().Where(x => x.ContentType.CompositionAliases.Contains("compSeo") && !x.Value<bool>("hideFromSearchEngines")))
        {
            if (node.TemplateId != 0 && node.ContentType.Alias != "sitemap")
            {
                <url>
                    <loc>@node.Url(mode: UrlMode.Absolute)</loc>
                    <lastmod>@(string.Format("{0:s}+00:00", node.UpdateDate))</lastmod>
                    <changefreq>@ValueOrDefault(node, "sitemapPageChangeFrequently", "daily", Fallback.ToAncestors)</changefreq>
                    <priority>@ValueOrDefault(node, "sitemapPagePriority", "0.5", Fallback.ToAncestors)</priority>
                </url>
            }

            if (node.Children().Any(x => x.TemplateId != 0))
            {
                ListChildNodes(node);
            }
        }
    }
}
