@inherits UmbracoViewPage
@inject ISettingsService _settingsService;
@{
    var site = Model.Root();

    var siteSettings = _settingsService.Get();
    var siteName = siteSettings?.SiteName;
    var companyName = siteSettings?.CompanyName;

    var siteLogo = siteSettings?.SiteLogo;

    // The link's only content is the logo and the site name, so with both settings blank it has no
    // accessible name; fall back to the company name, then the site's own node name.
    var logoName = new[] { siteName, companyName, site.Name }.FirstOrDefault(name => !string.IsNullOrWhiteSpace(name));
}

<a id="logo" href="@site.Url()" class="logo" title="@siteName" aria-label="@logoName">
    @if (siteLogo != null)
    {
        <picture>
            <source type="image/webp" srcset="@siteLogo.GetCropUrl(furtherOptions: "&format=webp")">
            <img src="@siteLogo.Url()" alt="@companyName">
        </picture>
    }
    <span>@siteName</span>
</a>
