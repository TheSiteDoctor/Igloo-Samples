@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<ContentModels.ImageBlock, ContentModels.ImageBlockSettings>>
@inject IDesignsService _designsService;

@{
    var settings = Model.Settings;
    var content = Model.Content;

    var pageDesign = _designsService.GetDesignFromPage(Umbraco.AssignedContentItem.Key, null);

    var containerWidth = (string?)ViewData["containerWidth"];

    var blockWidth = BlockHelper.GetSlotWidth(pageDesign, containerWidth, Model.ColumnSpan, Model.GridColumns);

    // The figure is capped to a percentage of the block from the md breakpoint up.
    var widthPercentage = int.TryParse(BlockHelper.RemovePercentageSymbol(settings?.ImageWidth), out var parsedPercentage)
        ? parsedPercentage
        : 100;

    var slotWidth = (int)Math.Ceiling(blockWidth * (widthPercentage / 100.0));

    var loadingState = "";
    if (Igloo.Extensions.HttpRequestExtensions.IsBlockPreviewRequest(Context.Request))
    {
        loadingState = "loaded";
    }

    var media = content.Image;

    if (media is null)
    {
        return;
    }

    var width = BlockHelper.GetColumnWidth(settings?.ImageWidth);
}

<igloo-block-wrap settings="settings" content="content">
    <figure class="@width">

        @if (content.Link is not null)
        {
            @:<a href="@content.Link.Url" target="@content.Link.Target" class="w-full h-full">
        }

        <picture class="block w-full h-full">
            <igloo-image media="media"
                         alt="@content.Caption"
                         slot-width="slotWidth"
                         class="block w-full h-full @loadingState"/>
        </picture>

        @if (content.Link is not null)
        {
            @:</a>
        }

        @if (string.IsNullOrWhiteSpace(content.Caption) == false)
        {
            <figcaption class="text-sm italic text-center">@content.Caption</figcaption>
        }
    </figure>
</igloo-block-wrap>

