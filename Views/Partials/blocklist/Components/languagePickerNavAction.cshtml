@using System.Globalization
@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem<ContentModels.LanguagePickerNavAction>>
@inject IDesignsService _designsService;
@inject Igloo.Services.Feed.IFeedService _feedService;
@{
    var site = Umbraco.AssignedContentItem.Root<Site>();
    if (site?.Cultures.Count == 1)
    {
        return;
    }

    var pageDesign = _designsService.GetDesignFromPage(Umbraco.AssignedContentItem.Key, null);

    var expandDictionaryValue = Umbraco.GetDictionaryValue("Show Subpages");

    CultureInfo currentCi = System.Threading.Thread.CurrentThread.CurrentCulture;
    // A blank Language Name is "", not null; without a fallback the link has no accessible name.
    var currentLanguageTitle = string.IsNullOrWhiteSpace(site?.LanguageName) ? Thread.CurrentThread.CurrentUICulture.NativeName : site.LanguageName;
    var currentFlagUrl = site?.LanguageFlag?.Url() ?? site?.GetCulture()?.GetFlag();

    // Stay on this page in the other language when it's published there, else go to that language's
    // home. A Feed Listing on the page keeps its filters, with categories mapped by key.
    var page = Umbraco.AssignedContentItem;
    var feedListing = Context.Items[Igloo.Services.Feed.FeedListingModel.ItemsKey] as Igloo.Services.Feed.FeedListingModel;
    string UrlFor(string culture)
    {
        if (page.ContentType.VariesByCulture() && !page.Cultures.ContainsKey(culture))
        {
            return site!.Url(culture);
        }

        var url = page.Url(culture);
        return feedListing is null
            ? url
            : Igloo.Services.Feed.FeedListingQueryString.ForCulture(url, feedListing.Query, feedListing.Prefix,
                slug => _feedService.ResolveCategory(feedListing.Feed, slug) is { } category ? _feedService.GetCategorySlug(category, culture) : null);
    }
}

<li class="language-selector has-children">
    <a href="#" class="main-nav-link" title="@currentLanguageTitle" data-culture="@currentCi.Name">
        <img loading='lazy' src="@currentFlagUrl" alt="@currentLanguageTitle"/>
        <span>@currentLanguageTitle</span>
        <igloo-nav-expand-button class="expand" open-icon="pageDesign?.NavExpandIcon" close-icon="pageDesign?.MobileNavCloseIcon" aria-label="@expandDictionaryValue"/>
    </a>
    <ul id="languageDropdown">
        @foreach (var (culture, infos) in site.Cultures)
        {
            CultureInfo ci = new CultureInfo(culture);
            var title = site.Value("languageName", fallback: Fallback.ToDefaultValue, defaultValue: ci.NativeName, culture: ci.Name);
            var flagUrl = site.Value<IPublishedContent>("languageFlag", culture: ci.Name)?.Url() != null ? site.Value<IPublishedContent>("languageFlag", culture: ci.Name)?.Url() : infos.GetFlag();

            <li>
                <a href="@UrlFor(culture)" class="main-nav-link" title="@title" data-culture="@ci.Name">
                    <img loading='lazy' src="@flagUrl" alt="@title"/>
                    <span>@title</span>
                </a>
            </li>
        }
    </ul>
</li>
